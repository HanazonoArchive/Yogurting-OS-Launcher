<?xml version="1.0" encoding="Shift_JIS"?>
<!-- MapID:1 エスティバー 屋外 -->
<field>
	<!-- オク前購買おばちゃんNo.2 -->
	<npc id="4" shell="3" x="120" y="47" dir="7" init="init" >
		<script name="init">
			<call name="peke.get.info" />
			<call name="peke.get.epi"/>

			<ifeq varname="local.school" value="1">
				<ifge varname="peke.epi.es" value="8">
						<jump label="pengin2_es3"/>
				</ifge>
				<ifge varname="peke.epi.es" value="7">
						<jump label="pengin2_es2"/>
				</ifge>
				<ifge varname="peke.epi.es" value="0">
						<jump label="pengin2_es1"/>
				</ifge>
			</ifeq>
			<ifge varname="peke.epi.es" value="8">
					<jump label="pengin2_yoi3"/>
			</ifge>
			<ifge varname="peke.epi.es" value="7">
					<jump label="pengin2_yoi2"/>
			</ifge>
			<ifge varname="peke.epi.es" value="0">
					<jump label="pengin2_yoi1"/>
			</ifge>
		</script>

		<!-- ▼エス生セリフ -->
		<dialog name="pengin2_es1" cutin="0" closebutton="1">
			<text><![CDATA[
				いらっしゃい～　新鮮な牛乳やで～！<br>
				おっ！　新入生かい！　新規のお客さんやね！　入学おめでとう、ちょくちょく寄ってってや～！　値引きはあらへんけど、ええもん揃てるで。
			]]></text>
			<selection next="buy" text="買い物をする" />
			<selection next="sell" text="アイテムを売る" />
			<selection next="next_menu" text="次のページを表示" />
		</dialog>

		<dialog name="pengin2_es2" cutin="0" closebutton="1">
			<text><![CDATA[
				ああ、よりによって配達が溜まってる時に限って事故に遭うなんかなぁ…あ～もう！<br>
				…あ、ええとこへ来たね！　もし時間あったら、荷物運ぶの手伝ってくれへん？
			]]></text>
			<selection next="buy" text="買い物をする" />
			<selection next="sell" text="アイテムを売る" />
			<selection next="next_menu" text="次のページを表示" />
		</dialog>

		<dialog name="pengin2_es3" cutin="0" closebutton="1">
			<text><![CDATA[
				あらぁ～、この前バイト君が遅れて困ってた時、手伝ってくれた生徒さんやね。あん時は助かったで。今後も何かバイト要る時には言うさかい、またよろしゅう頼むわ～！
			]]></text>
			<selection next="buy" text="買い物をする" />
			<selection next="sell" text="アイテムを売る" />
			<selection next="next_menu" text="次のページを表示" />
		</dialog>

		<!-- ▼宵生セリフ -->
		<dialog name="pengin2_yoi1" cutin="0" closebutton="1">
			<text><![CDATA[
				見かけへん顔やねぇ…ははぁ、宵月から来たんやな。なあ～、牛乳は新鮮で武器もええもんが揃ってるよ、いっぺん見てってな！　そっちじゃどないなんか知らへんけど、うちは値引きはせぇへんよ～！
			]]></text>
			<selection next="buy" text="買い物をする" />
			<selection next="sell" text="アイテムを売る" />
			<selection next="next_menu" text="次のページを表示" />
		</dialog>

		<dialog name="pengin2_yoi2" cutin="0" closebutton="1">
			<text><![CDATA[
				ああ、よりによって配達が溜まってる時に事故やなんて、もしかして仮病とちゃうんかなぁ…あ～もう！　…あ、ええとこへ来たね！　もし時間あったら、エスティバーの 1階へ行って荷物運ぶの手伝ってくれへん？
			]]></text>
			<selection next="buy" text="買い物をする" />
			<selection next="sell" text="アイテムを売る" />
			<selection next="next_menu" text="次のページを表示" />
		</dialog>

		<dialog name="pengin2_yoi3" cutin="0" closebutton="1">
			<text><![CDATA[
				あらぁ～、この前バイト君が遅れて困ってた時、手伝ってくれた生徒さんやね。あの時は助かったよ、ほんま！
			]]></text>
			<selection next="buy" text="買い物をする" />
			<selection next="sell" text="アイテムを売る" />
			<selection next="next_menu" text="次のページを表示" />
		</dialog>

		<!-- ▼クエスト -->
		<dialog name="next_menu" cutin="0" closebutton="1">
			<text><![CDATA[
				あ、ちょうど今、割のええバイトがあるで。
			]]></text>
			<selection next="pengin2_quest_no" text="新しいクエスト表示" />
			<selection next="pengin2_quest_miss" text="クエスト達成を報告する" />
		</dialog>

		<dialog name="pengin2_quest_no" cutin="0" closebutton="1">
			<text><![CDATA[
				せやなぁ…今はバイトは必要あらへんな。
			]]></text>
			<selection text="そうですか、それじゃまた" />
		</dialog>

		<dialog name="pengin2_quest_miss" cutin="0" closebutton="1">
			<text><![CDATA[
				んん？　アンタたちは雇ってへんで？
			]]></text>
			<selection text="そうでした、すみません" />
		</dialog>

		<buy name="buy">
			<coitem type="10001" price="50" />	<!-- 三角牛乳 -->
			<coitem type="10006" price="100" />	<!-- 高級三角牛乳 -->
			<coitem type="10002" price="160" />	<!-- パック牛乳 -->
			<coitem type="10007" price="220" />	<!-- 高級パック牛乳 -->
			<coitem type="10003" price="330" />	<!-- 瓶牛乳 -->
			<coitem type="10008" price="420" />	<!-- 高級瓶牛乳 -->
			<coitem type="10004" price="600" />	<!-- 大瓶牛乳 -->
			<coitem type="10009" price="730" />	<!-- 高級大瓶牛乳 -->
			<coitem type="10010" price="900" />	<!-- PETボトル牛乳 -->
			<coitem type="10011" price="1050" />	<!-- 高級PETボトル牛乳 -->
			<coitem type="20001" price="100" />	<!-- ガンバミン101 -->
			<coitem type="20003" price="330" />	<!-- ガンバミン202 -->
			<coitem type="20002" price="900" />	<!-- ガンバミン404 -->
			<coitem type="30216" price="150" />	<!-- エスティバー乗車券 -->
			<beitem type="110006" price="100" />	<!-- 木刀 -->
			<beitem type="120001" price="100" />	<!-- 有備無患 -->
			<beitem type="130006" price="100" />	<!-- パンフルート -->
			<beitem type="140001" price="100" />	<!-- アクアマリン -->
			<coitem type="30128" price="5000" />	<!-- 友情の石(開設) -->
			<coitem type="30129" price="30000" />	<!-- 友情の石(LvUP) -->
			<coitem type="30131" price="8000" />	<!-- 友情の石(名前変更) -->
			<enitem type="10001" price="500" />	<!-- 1年生強化参考書 -->
			<enitem type="10002" price="2000" />	<!-- 2年生強化参考書 -->
			<enitem type="10003" price="8000" />	<!-- 3年生強化参考書 -->
			<enitem type="10004" price="32000" />	<!-- 4年生強化参考書 -->
			<enitem type="10005" price="128000" />	<!-- 5年生強化参考書 -->
			<coitem type="40003" price="2000" />	<!-- 武器源石ボックス[1年生] -->
			<coitem type="40004" price="8000" />	<!-- 武器源石ボックス[2年生] -->
			<coitem type="40005" price="32000" />	<!-- 武器源石ボックス[3年生] -->
			<coitem type="40006" price="128000" />	<!-- 武器源石ボックス[4年生] -->
			<coitem type="40007" price="512000" />	<!-- 武器源石ボックス[5年生] -->
			<coitem type="40026" price="2000" />	<!-- 制服源石ボックス[1年生] -->
			<coitem type="40027" price="8000" />	<!-- 制服源石ボックス[2年生] -->
			<coitem type="40028" price="32000" />	<!-- 制服源石ボックス[3年生] -->
			<coitem type="40029" price="128000" />	<!-- 制服源石ボックス[4年生] -->
			<coitem type="40030" price="512000" />	<!-- 制服源石ボックス[5年生] -->
		</buy>
		<sell name="sell" />
	</npc>
</field>