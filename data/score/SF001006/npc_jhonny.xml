<?xml version="1.0" encoding="Shift_JIS"?>
<!-- MapID:26 エスティバー 裏庭 -->
<field>
	<!-- ジョニー -->
	<npc id="6" shell="5" x="38" y="105" dir="3" init="init" >
		<script name="init">
			<call name="peke.get.info" />
			<call name="peke.get.epi"/>

			<ifeq varname="local.school" value="1">
				<ifge varname="peke.epi.es" value="0">
						<jump label="jhonny_es1"/>
				</ifge>
			</ifeq>
			<ifge varname="peke.epi.es" value="0">
					<jump label="jhonny_yoi1"/>
			</ifge>
		</script>

		<!-- ▼エス生セリフ -->
		<dialog name="jhonny_es1" cutin="0" closebutton="1">
			<text><![CDATA[
				お、よく来たな。いつでも温室に遊びに来なよ。
			]]></text>
			<selection next="jhonny_quest_no" text="新しいクエスト表示" />
			<selection next="jhonny_quest_miss" text="クエスト達成を報告する" />
		</dialog>

		<!-- ▼宵生セリフ -->
		<dialog name="jhonny_yoi1" cutin="0" closebutton="1">
			<text><![CDATA[
				別の学校から遊びに来てくれたのかい？<br>
				俺は温室を管理してるジョニーってもんだ、<br>
				よろしく頼むわ。
			]]></text>
			<selection next="jhonny_quest_no" text="新しいクエスト表示" />
			<selection next="jhonny_quest_miss" text="クエスト達成を報告する" />
		</dialog>

		<!-- ▼クエスト -->
		<dialog name="jhonny_quest_no" cutin="0" closebutton="1">
			<text><![CDATA[
				今んとこ、人手は足りてるねぇ。
			]]></text>
			<selection text="そうですか、それじゃまた" />
		</dialog>

		<dialog name="jhonny_quest_miss" cutin="0" closebutton="1">
			<text><![CDATA[
				頼み事なんてしたかなぁ…<br>
				何か間違ってるのと違うかい？
			]]></text>
			<selection text="すみません、失礼します" />
		</dialog>
	</npc>
</field>