<?xml version="1.0" encoding="Shift_JIS"?>
<!-- MapID:162 宵月学院 停留場 -->
<field>
	<!-- バスおばちゃん -->
	<npc id="177" shell="3" x="89" y="56" dir="7" init="init">
		<script name="init">
			<call name="peke.get.info" />
			<call name="peke.get.epi"/>

			<ifeq varname="local.school" value="2">
				<ifge varname="peke.epi.yoi" value="0">
					<jump label="pengin_yoi1"/>
				</ifge>
			</ifeq>
			<ifge varname="peke.epi.yoi" value="0">
				<jump label="pengin_es1"/>
			</ifge>
		</script>

		<!-- ▼宵生セリフ -->
		<dialog name="pengin_yoi1" cutin="0" closebutton="1">
			<text><![CDATA[				
					いらっしゃい、今日はどないしたん？
				]]></text>
			<selection next="busST" text="Estivaに行きたい" />
			<selection next="pengin_quest_no" text="新しいクエスト表示" />
			<selection next="pengin_quest_miss" text="クエスト達成を報告する" />
		</dialog>

		<!-- ▼エス生セリフ -->
		<dialog name="pengin_es1" cutin="0" closebutton="1">
			<text><![CDATA[
				お～、Estivaからここまで遊びに来たんやね、うれしいなぁ。
			]]></text>
			<selection next="busST" text="Estivaに行きたい" />
			<selection next="pengin_quest_no" text="新しいクエスト表示" />
			<selection next="pengin_quest_miss" text="クエスト達成を報告する" />
		</dialog>

		<!-- ▼クエスト -->
		<dialog name="pengin_quest_no" cutin="0" closebutton="1">
			<text><![CDATA[
				せやなぁ…今はバイトは必要あらへんな。
			]]></text>
			<selection text="そうですか、それじゃまた" />
		</dialog>

		<dialog name="pengin_quest_miss" cutin="0" closebutton="1">
			<text><![CDATA[
				んん？　アンタたちは雇ってへんで？
			]]></text>
			<selection text="そうでした、すみません" />
		</dialog>

		<!-- 宵バスでSTへ -->
		<bus name="busST" school="2" idDestField="27" xDest="106" yDest="59" />
	</npc>
</field>