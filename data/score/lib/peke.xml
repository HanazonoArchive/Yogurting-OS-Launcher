<?xml version="1.0" encoding="Shift_JIS"?>
<library>
	<!-- ジャンケン判定 -->
	<!--	cutin	00通常　01喜び　02悲しみ　11チョキ　12グー　13パー
		判定	00チョキ　01グー　02パー
		((ＮＰＣ手－プレイヤー手－) + 3) mod 3＝00引き分け　01プレイヤー負け　02プレイヤー勝ち
	-->
	<function name="janken.judge">
		<rnd varname="peke.temp2" value="3"/>
		<set varname="peke.temp3" value="${peke.temp2}" />
		<add varname="peke.temp3" value="11" />
		<sub varname="peke.temp2" value="${peke.temp}"/>
		<add varname="peke.temp2" value="3"/>
		<mod varname="peke.temp2" value="3"/>
		<switch varname="peke.temp">
			<case value="1">
				<set varname="peke.temp" value="グー"/>
			</case>
			<case value="0">
				<set varname="peke.temp" value="チョキ"/>
			</case>
			<case value="2">
				<set varname="peke.temp" value="パー"/>
			</case>
		</switch>
	</function>

	<!-- プレイヤー情報取得 -->
	<function name="get.info">
		<getcharinfo varname="local.name " type="name"/>
		<getcharinfo varname="local.sex" type="sex"/>
		<getcharinfo varname="local.school" type="school"/>
		<getcharinfo varname="local.grade" type="grade"/>
		<getcharinfo varname="local.level" type="level"/>
		<getcharinfo varname="local.taff" type="taff"/>
	</function>

	<!-- エピ情報 -->
	<function name="get.epi">
