function parse(packet){
	with(packet){
		setTitle("カプセル販売機購入返答");
		readInt32("戻り値");
		readInt32("unknown");
		readInt32("typeItem+typeNum");
		readWord("count or Dim1Index");
		readWord("invalid or Dim2Index");
		readInt32("invalid or idItem");
		readInt64("price");
		readInt64("resultMoney");
		readInt64("totalAmount");
	}
}
