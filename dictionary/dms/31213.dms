import struct.*;
function parse(packet){
	with(packet){
		setTitle("プレゼントボックス結果通知");
		readInt32("戻り値");
		var cnt = readWord("vecItemsCount");
		for(var i = 1; i <= cnt; i++){
			//readInt32();
			//readWord("Index1");
			//readWord("Index2");
			//readInt32("ObjectID");
			readItem(packet, false);
		}
		readInt32("reqBeSize");
		readInt32("reqCoSize");
	}
}
