function char_disp_info(packet){
	packet.readUInt32("キャラID");
	packet.readUInt32("学年");
	packet.readWStr(0x1C, "キャラ名");
	packet.readUInt32("学校ID");
	packet.readUInt32("マークID");
	packet.readUInt32("電話番号");
	packet.readInt64("所持金");
	packet.readUInt32("性別");
	packet.readUInt32("顔タイプ");
	packet.readUInt32("髪タイプ");
	packet.readUInt32("肌タイプ");
	packet.readWStr(0x1C, "同好会名");
	packet.readUInt32("レベル");
	packet.readUInt32("頭装備");
	packet.readUInt32();
	packet.readUInt32("バック？");
	packet.readUInt32("武器");
	packet.readUInt32("手装備？");
	packet.readUInt32();
	packet.readUInt32("服(上)");
	packet.readUInt32("服(下)");
	packet.readUInt32("靴");

	packet.readUInt32("源石解除可能(頭)");
	packet.readUInt32("源石解除可能(?)");
	packet.readUInt32("源石解除可能(バック？)");
	packet.readUInt32("源石解除可能(武器)");
	packet.readUInt32("源石解除可能(手)");
	packet.readUInt32("源石解除可能(?)");
	packet.readUInt32("源石解除可能(服上)");
	packet.readUInt32("源石解除可能(服下)");
	packet.readUInt32("源石解除可能(靴)");
	for(var i=1 ; i<=5 ; i++) {
		packet.readUInt32("頭装備源石？"+i.toString());
	}
	for(var i=1 ; i<=5 ; i++) {
		packet.readUInt32("Unknown"+i.toString());
	}
	for(var i=1 ; i<=5 ; i++) {
		packet.readUInt32("バック？"+i.toString());
	}
	for(var i=1 ; i<=5 ; i++) {
		packet.readUInt32("武器源石"+i.toString());
	}
	for(var i=1 ; i<=5 ; i++) {
		packet.readUInt32("手装備源石？"+i.toString());
	}
	for(var i=1 ; i<=5 ; i++) {
		packet.readUInt32();
	}
	for(var i=1 ; i<=5 ; i++) {
		packet.readUInt32("服(上)源石"+i.toString());
	}
	for(var i=1 ; i<=5 ; i++) {
		packet.readUInt32("服(下)源石"+i.toString());
	}
	for(var i=1 ; i<=5 ; i++) {
		packet.readUInt32("靴源石"+i.toString());
	}
}

// 武器熟練度
function weapon_dex_info(packet, count){
	var s = ["", "ブレード", "グローブ", "ミューラ", "スピリット"];
	for(var i = 1; i <= count; i++){
		if (i <= 4){
			packet.readInt32(s[i]+"熟練度レベル");
			packet.readInt32(s[i]+"熟練度経験値");
			packet.readInt32(s[i]+"熟練度最大経験値");
		}else{
			packet.readInt32("熟練度レベル" + i.toString());
			packet.readInt32("熟練度経験値" + i.toString());
			packet.readInt32("熟練度最大経験値" + i.toString());
		}
	}
}

function char_play_info(packet){
	with(packet){
		readUInt32("キャラID");
		readWStr(0x1A, "キャラ名");
		readUInt32("電話番号");
		readByte("性別");
		readWord("学校ID");
		readWStr(8, "ギルドID");
		readUInt32("マークID");
		readUInt32("顔タイプ");
		readUInt32("髪タイプ");
		readUInt32("肌タイプ");
		readUInt32("レベル");
		readByte("学年");
		readUInt32("メインクエストポイント");
		readUInt32("サブクエストポイント");
		readInt64("所持金");
		readInt64("銀行預金");
		readUInt32("ショップポイント");
		readUInt32("基本HP");
		readUInt32("現在HP");
		readUInt32("基本攻撃力");
		readUInt32("基本防御力");
		readUInt32("基本命中率");
		readUInt32("フィールドID");
		readWord("X");
		readWord("Y");
		for(var i = 1; i <= 10; i++){
			readUInt32("クイックアイテム種類" + i.toString());
		}
		for(var i = 1; i <= 20; i++){
			readUInt32("クイックアイテムID" + i.toString());
		}
		readUInt32("体力");
		readUInt32("瞬発力");
		readUInt32("技術");
		readUInt32("運");
		readUInt32("最大HP");
		readUInt32("uguuMax");
		readUInt32("uguuCurrent");
		readByte("チャージポイント");
		readUInt32("攻撃力");
		readUInt32("防御力");
		readUInt32("命中");
		readUInt32("回避");
		readUInt32("クリティカル");
		readUInt32("攻撃速度");
		readUInt32("移動速度");
		readUInt32("クールタイム");
		readUInt32("経験値");
		readUInt32("最大経験値");

		for(var i = 1; i <= 5; i++){
			readUInt32("クエストID" + i.toString());
		}
		for(var i = 1; i <= 8; i++){
			readUInt32("titleGetVec" + i.toString());
		}
		for(var i = 1; i <= 8; i++){
			readUInt32("titleActiveVec" + i.toString());
		}
		readInt32("equipedTitle");
		readInt32("groove");
		readSingle("fCurCalorie");
		readSingle("fPcConsumeRate");
		readInt32("idCurYogurt");
		readWStr(0x1A, "同好会名");

		for(var i = 1; i <= 9; i++){
			readWord("装備アイテムID_curEquipPart" + i.toString());
			readWord("装備アイテムID???" + i.toString());
			readInt32("装備アイテムID???" + i.toString());
			//readInt64("装備アイテムID");
		}
		for(var i = 1; i <= 9; i++){
			readInt32("bByulPart" + i.toString());
		}
		weapon_dex_info(packet, 4);
		readInt32("skillPoint");
		var cnt = readWord("vecSkillListCount");
		for(var i = 1; i <= cnt; i++){
			readInt32("Skill" + i.toString());
		}
		for(var i = 1; i <= 9; i++){
			readInt32("ブレードスキルショートカット" + i.toString());
		}
		for(var i = 1; i <= 9; i++){
			readInt32("グローブスキルショートカット" + i.toString());
		}
		for(var i = 1; i <= 9; i++){
			readInt32("ミューラスキルショートカット" + i.toString());
		}
		for(var i = 1; i <= 9; i++){
			readInt32("スピリットスキルショートカット" + i.toString());
		}
	}
}

function char_beitem_list(packet, count){
	for(var i = 1; i <= count; i++){
		var dim1 = packet.readWord("  idBeItemDim1Index" + i.toString());
		var dim2 = packet.readWord("  idBeItemDim2Index" + i.toString());
		packet.readInt32("  idBeItem[" + dim1.toString() + "][" + dim2.toString() + "]" +  i.toString());
		packet.readInt32("  typeBeItem" + i.toString());
		for(var j = 1; j <= 5; j++){
			packet.readInt32("    reinforceslot" + i.toString() + "-" + j.toString());
		}
	}
}

