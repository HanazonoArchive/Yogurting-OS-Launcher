function room_info(packet){
	with(packet){
		readWord("snRoom");
		readWord("idLobby");
		readByte("status");
		readBinary(1, "(padding)");
		readWStr(42, "title");
		readUInt32("idEpisodeType");
		readByte("cntMaxUser");
		readByte("cntCurrentUser");
		readByte("cntTeam");
		readByte("bPassWord");
		readByte("bPK");
		readByte("bLimitMilk");
		readByte("bWaiting");
		readByte("clearRate");
		readSingle("scheduleCalorieEnter");
		readSingle("scheduleCalorieConsume");
	}
}

