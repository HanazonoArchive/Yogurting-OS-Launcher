function episode_info(packet, count){
	for(var i = 1; i <= count; i++){
		packet.readInt32("  epTypeId" + i.toString());
		packet.readSingle("  defaultCalorieEnter" + i.toString());
		packet.readSingle("  defaultCalorieConsume" + i.toString());
		packet.readSingle("  eventScheduleRate" + i.toString());
	}
}

function readItem(packet, reinforceslot){
	with(packet){
		switch(readInt32("typeItem+typeNum") & 0xFF000000){
			case 0x01000000: //Taff
				readInt32("taff");
				readInt32("(invalid)");
				if(reinforceslot){
					readBinary(20, "(padding)");
				}
				break;
			case 0x02000000: //BeItem
				readWord("dim1Index");
				readWord("dim2Index");
				readInt32("idItem");
				if(reinforceslot){
					readInt32("reinforceslot[0]");
					readInt32("reinforceslot[1]");
					readInt32("reinforceslot[2]");
					readInt32("reinforceslot[3]");
					readInt32("reinforceslot[4]");
				}
				break;
			case 0x03000000: //CoItem
			case 0x04000000: //QuestItem
			case 0x05000000: //EnItem
				readInt32("count");
				readInt32("(invalid)");
				if(reinforceslot){
					readBinary(20, "(padding)");
				}
				break;
			default:
				if(reinforceslot){
					readBinary(28, "(padding)");
				}else{
					readBinary(8, "(padding)");
				}
		}
	}
}